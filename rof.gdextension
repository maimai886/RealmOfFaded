; 邏輯擴充。開發時直接讀 cargo 編出來的檔，匯出時再複製
; 這個檔不能有 BOM，有的話 Godot 只報載入失敗
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://rust/target/debug/rof_gdext.dll"
windows.release.x86_64 = "res://rust/target/release/rof_gdext.dll"
macos.debug = "res://rust/target/debug/librof_gdext.dylib"
macos.release = "res://rust/target/release/librof_gdext.dylib"
linux.debug.x86_64 = "res://rust/target/debug/librof_gdext.so"
linux.release.x86_64 = "res://rust/target/release/librof_gdext.so"
